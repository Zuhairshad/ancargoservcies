# --- Staff area -------------------------------------------------------------
# Password for /admin. The staff area redirects to login without it.
ADMIN_PASSWORD=change-me

# --- Public URL -------------------------------------------------------------
# Base URL encoded into the QR code on carton labels.
NEXT_PUBLIC_SITE_URL=https://ancargoservices.com

# --- Database ---------------------------------------------------------------
# Without this the app runs on an in-memory store and bookings are lost on
# restart. After setting it:  npm run db:migrate && npm run db:seed
DATABASE_URL=postgres://user:password@host:5432/ancs

# --- Outbound email ---------------------------------------------------------
# SMTP for the info@ancargoservices.com mailbox. Without SMTP_HOST, messages are
# written to the server log instead of sent — nothing breaks, but customers get
# no booking receipts. Port 465 uses implicit TLS; 587 starts plain and upgrades.
SMTP_HOST=mail.ancargoservices.com
SMTP_PORT=587
SMTP_USER=info@ancargoservices.com
SMTP_PASSWORD=
SMTP_FROM=AN Cargo Services <info@ancargoservices.com>

# Where enquiries and internal notifications land. Defaults to SMTP_FROM's address.
OFFICE_INBOX=info@ancargoservices.com
