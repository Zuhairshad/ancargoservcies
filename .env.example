# Password for the staff area at /admin. Set this in your host's environment.
ADMIN_PASSWORD=change-me

# Public base URL — used to build the tracking URL encoded in carton QR codes.
NEXT_PUBLIC_SITE_URL=https://ancargoservices.com

# Postgres connection string. Without it the app falls back to an in-memory
# store and bookings are lost on restart. After setting it, run:
#   npm run db:migrate && npm run db:seed
DATABASE_URL=postgres://user:password@host:5432/ancs
